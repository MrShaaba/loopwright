{
  "name": "loopwright",
  "version": "0.1.0",
  "private": true,
  "description": "Ride a glowing ball through a glowing tube at the speed you choose.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "npm run check && vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@babylonjs/core": "9.33.1",
    "svelte": "5.57.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
